# ---------- Teodoro Prime Garden: velocidade e SEO ----------

# HTTPS e sem "www"
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://teodoroflores.com.br%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://teodoroflores.com.br%{REQUEST_URI} [L,R=301]
</IfModule>

# Endereços do site antigo (WordPress) -> páginas novas, sem perder o Google
Redirect 301 /produtos-teodoro-prime/ /produtos.html
Redirect 301 /produtos/ /produtos.html
Redirect 301 /contato/ /contato.html
Redirect 301 /politica-de-privacidade/ /politica-de-privacidade.html
Redirect 301 /dicas-teodoro-flores/ https://www.youtube.com/@teodoroflores689
Redirect 301 /vlog/teodoro-flores/ /index.html#sobre

# Compressão
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Cache: fotos, fontes, CSS e JS ficam guardados no navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp

# Não exibir arquivos de trabalho
<FilesMatch "^(_lista-imagens\.json|otimizar-imagens.*|LEIA-ME\.txt)$">
  Require all denied
</FilesMatch>
